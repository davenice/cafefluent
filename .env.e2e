# Used by `npm run test:e2e` (vite build --mode e2e). The .test domain never
# resolves, so the e2e build cannot reach the real config Lambda: Playwright
# answers this URL with the fake in e2e/fakeConfigApi.ts.
VITE_MODULES_API_URL=https://modules.test/
# Answered by the fake in e2e/fakeRecordingsApi.ts, the same way.
VITE_RECORDINGS_API_URL=https://recordings.test/
